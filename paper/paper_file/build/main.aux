\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {System overview.} Top: AHa-3D~\cite  {aha3d} computes a reference geometry from a handheld video (cameras and points from Pi3X, the released update of $\pi ^3$~\cite  {pi3}; structural masks from SAM~3~\cite  {sam3}), an agent authors the room in Blender against renders from the video's cameras, and an optional pass adds materials. Middle: one held-out room at each stage, built with the checklist (342 instances of any size; those under 50\,cm are blue). The inset is the AHa-3D baseline scene of the same room, with 37. Bottom: our additions, each evaluated separately: a checklist for small objects (Section~\ref {sec:small-method}; the four entries are real, and the entry counts and the bar of the agent's decisions cover the six held-out rooms), concurrent object builds (Section~\ref {sec:architecture}) and physical properties (Appendix~\ref {sec:physics-plan}).}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:system}{{1}{3}{\textbf {System overview.} Top: AHa-3D~\cite {aha3d} computes a reference geometry from a handheld video (cameras and points from Pi3X, the released update of $\pi ^3$~\cite {pi3}; structural masks from SAM~3~\cite {sam3}), an agent authors the room in Blender against renders from the video's cameras, and an optional pass adds materials. Middle: one held-out room at each stage, built with the checklist (342 instances of any size; those under 50\,cm are blue). The inset is the AHa-3D baseline scene of the same room, with 37. Bottom: our additions, each evaluated separately: a checklist for small objects (Section~\ref {sec:small-method}; the four entries are real, and the entry counts and the bar of the agent's decisions cover the six held-out rooms), concurrent object builds (Section~\ref {sec:architecture}) and physical properties (Appendix~\ref {sec:physics-plan})}{figure.1}{}}
