\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces All six held-out rooms in the format of Figure~\ref {fig:qual}. Rooms 1, 2, 3 and 6 use the frame that sees the most annotated targets under 50\,cm; in rooms 4 and 5 that frame faces a bare wall, and we show a frame chosen by hand instead. Figure~\ref {fig:qual} shows room 6 from a second, hand-picked frame. Checklist was below Inventory in rooms 3, 4 and 5.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:qual-all}{{6}{13}{All six held-out rooms in the format of Figure~\ref {fig:qual}. Rooms 1, 2, 3 and 6 use the frame that sees the most annotated targets under 50\,cm; in rooms 4 and 5 that frame faces a bare wall, and we show a frame chosen by hand instead. Figure~\ref {fig:qual} shows room 6 from a second, hand-picked frame. Checklist was below Inventory in rooms 3, 4 and 5}{figure.6}{}}
