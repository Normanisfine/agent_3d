\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {The same view under four variants.} Columns two to five render each saved scene from the camera of the video frame under one light and material setup. Instances tied to objects under 50\,cm are \textcolor {okblue}{\rule  {0.8em}{0.8em}}~correctly placed, \textcolor {misorange}{\rule  {0.8em}{0.8em}}~matched but misplaced or \textcolor {extragreen}{\rule  {0.8em}{0.8em}}~without an annotated counterpart. Last column: the Checklist scene after AHa-3D's appearance pass, geometry unchanged. Counts are correct placements under 50\,cm in the whole room, not in the view. Rooms and frames were chosen to show small objects; Figure~\ref {fig:qual-all} shows all six rooms, including the three in which Inventory placed more.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:qual}{{5}{7}{\textbf {The same view under four variants.} Columns two to five render each saved scene from the camera of the video frame under one light and material setup. Instances tied to objects under 50\,cm are \swatch {okblue}~correctly placed, \swatch {misorange}~matched but misplaced or \swatch {extragreen}~without an annotated counterpart. Last column: the Checklist scene after AHa-3D's appearance pass, geometry unchanged. Counts are correct placements under 50\,cm in the whole room, not in the view. Rooms and frames were chosen to show small objects; Figure~\ref {fig:qual-all} shows all six rooms, including the three in which Inventory placed more}{figure.5}{}}
