\newlabel{fig:ai2thor}{{3}{5}{AI2-THOR input (left) and the original AHa-3D reconstruction (right). The furniture layout is recognizable, yet the laptop was the only one of 18 annotated objects under 50\,cm correctly placed as an independent instance}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Six held-out rooms, 857 targets.} \textbf  {a}, Outcome by target size: solid bars are correctly placed targets (count below each bar, the largest in bold), hatched extensions are matched but misplaced. \textbf  {b}, Share of targets under 50\,cm correctly placed in each room; the diamond is a second Checklist run with identical settings. \textbf  {c}, Correct placements under 50\,cm against the share of reconstructed instances that match any target. Squares score an inventory's boxes directly, with no agent, and the arrow leads to the run of the agent that was given them.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:results}{{4}{6}{\textbf {Six held-out rooms, 857 targets.} \textbf {a}, Outcome by target size: solid bars are correctly placed targets (count below each bar, the largest in bold), hatched extensions are matched but misplaced. \textbf {b}, Share of targets under 50\,cm correctly placed in each room; the diamond is a second Checklist run with identical settings. \textbf {c}, Correct placements under 50\,cm against the share of reconstructed instances that match any target. Squares score an inventory's boxes directly, with no agent, and the arrow leads to the run of the agent that was given them}{figure.4}{}}
