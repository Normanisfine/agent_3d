\newlabel{tab:inventory}{{6}{14}{Inventories scored without an agent on five development rooms. Rows beginning with + add one step to the row above. Matched: share of targets with a candidate match. Placed: share whose inventory box passes center and size. Entries matched: share of inventory entries that match any target}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces All six held-out rooms in the format of Figure~\ref {fig:qual}. Rooms 1, 2, 3 and 6 use the frame that sees the most annotated targets under 50\,cm; in rooms 4 and 5 that frame faces a bare wall, and we show a frame chosen by hand instead. Figure~\ref {fig:qual} shows room 6 from a second, hand-picked frame. Checklist was below Inventory in rooms 3, 4 and 5.}}{15}{figure.8}\protected@file@percent }
\newlabel{fig:qual-all}{{8}{15}{All six held-out rooms in the format of Figure~\ref {fig:qual}. Rooms 1, 2, 3 and 6 use the frame that sees the most annotated targets under 50\,cm; in rooms 4 and 5 that frame faces a bare wall, and we show a frame chosen by hand instead. Figure~\ref {fig:qual} shows room 6 from a second, hand-picked frame. Checklist was below Inventory in rooms 3, 4 and 5}{figure.8}{}}
